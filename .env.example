# 拷贝为 .env 后按需修改。
#
# ---- 前端（构建期注入，Vite 只读取 VITE_ 前缀）----
# 高德地图 Web Key；留空则地图不加载底图，但投稿/审核流程仍可测试。
VITE_AMAP_KEY=

# ---- 后端运行时 ----
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
DIST_DIR=dist

# 初始管理员账号（仅首次启动、数据库中还没有管理员时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=

# 每台设备每天最多投稿次数
MAX_SUBMISSIONS_PER_DAY=5
# 是否开放匿名投稿
ENABLE_PUBLIC_SUBMISSIONS=true
# 是否写入演示地点（默认关闭）
SEED_DEMO_PLACES=false
